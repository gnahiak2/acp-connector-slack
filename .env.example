# Required: dashboard admin credential (12+ characters). Never commit a real value.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_USER=admin
SESSION_TTL_HOURS=12

# Deployment: local (trusted-local runner) or server (container runner required)
SLACKBOARD_MODE=local
HOST=127.0.0.1
PORT=8787
PUBLIC_URL=http://localhost:8787
DATA_DIR=./data
# DATABASE_PATH=./data/slackboard.db
# WORKSPACE_ROOT=./data/workspaces
# WEB_DIST=./apps/web/dist
SKILLS_DIR=./skills
AGENTS_CONFIG=./config/agents.json
LOG_LEVEL=info
TRUST_PROXY=false
ALLOW_INSECURE_HTTP=false

# Slack Socket Mode. Both tokens are required to enable Slack.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...
# Comma-separated Slack ids. Empty means deny every request. "*" allows all (not recommended).
SLACK_ALLOWED_USERS=
SLACK_ALLOWED_CHANNELS=
# SLACK_DEFAULT_AGENT=
# SLACK_DEFAULT_PROJECT=

# Runner
RUNNER_TYPE=local
# CONTAINER_IMAGE=ghcr.io/example/agent:verified
# CONTAINER_IMAGE_ALLOWLIST=ghcr.io/example/agent:verified
CONTAINER_NETWORK=none
CONTAINER_MEMORY_MB=1024
CONTAINER_CPUS=1
CONTAINER_PIDS_LIMIT=256

# GitHub App (all three required to enable, plus a non-empty allowlist)
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/app.private-key.pem
# GITHUB_INSTALLATION_ID=
# GITHUB_ALLOWED_REPOS=owner/repo,owner/other-repo

# Limits (optional; defaults shown)
GLOBAL_CONCURRENCY=2
PROMPT_TIMEOUT_MS=600000
APPROVAL_TIMEOUT_MS=120000
AGENT_START_TIMEOUT_MS=30000
AGENT_IDLE_TIMEOUT_MS=900000
MAX_MESSAGE_BYTES=1048576
MAX_FILE_BYTES=1048576
TERMINAL_OUTPUT_BYTES=262144
MAX_EVENT_BYTES=65536
MAX_SKILL_BYTES=262144
SLACK_CHUNK_CHARS=3200
SLACK_UPDATE_INTERVAL_MS=800
MEMORY_RETENTION_DAYS=0
