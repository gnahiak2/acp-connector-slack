{
  "display_information": {
    "name": "Slackboard",
    "description": "Self-hosted coding agent operations with approvals and a dashboard.",
    "background_color": "#205c49"
  },
  "features": {
    "bot_user": {
      "display_name": "Slackboard",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/slackboard",
        "description": "Manage agent sessions, skills, memory and approvals",
        "usage_hint": "help | start [agent] [project] | status | stop | skill | memory | doctor",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
