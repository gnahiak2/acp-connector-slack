{
  "name": "slackboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @slackboard/server dev",
    "dev:web": "pnpm --filter @slackboard/web dev",
    "build": "pnpm --filter \"./packages/*\" -r run build && pnpm --filter @slackboard/server run build && pnpm --filter @slackboard/web run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
